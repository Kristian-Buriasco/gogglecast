<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- `com.apple.developer.system-extension.install` deliberately
	     NOT included here. Confirmed (Task 4.1, post-fix): that
	     entitlement requires a paid Apple Developer Program membership
	     just to provision; without one, AMFI rejects the WHOLE APP at
	     launch (Error -413 "No matching profile found"), not just the
	     extension-install call. This is the default, day-to-day-usable
	     app entitlements file; see GogglesView-with-extension-install
	     .entitlements for the Task-4.1-testing variant (usable only once
	     a paid membership is active). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.kburiasco.gogglesview</string>
	</array>
</dict>
</plist>
