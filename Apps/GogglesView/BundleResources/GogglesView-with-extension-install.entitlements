<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release variant with the OBS virtual camera (CMIO system extension). The system-extension install
	     entitlement is restricted: it only launches when the app carries a matching Developer ID provisioning
	     profile (Contents/embedded.provisionprofile, passed to build-stub-bundle.sh as GOGGLESVIEW_APP_PROFILE).
	     The identifiers below come from that profile. Used with GOGGLESVIEW_WITH_EXTENSION_INSTALL=1. -->
	<key>com.apple.developer.system-extension.install</key>
	<true/>
	<key>com.apple.application-identifier</key>
	<string>5A3R74QNBJ.com.kburiasco.gogglesview</string>
	<key>com.apple.developer.team-identifier</key>
	<string>5A3R74QNBJ</string>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
