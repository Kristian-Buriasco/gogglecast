<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A CMIOExtension system extension always runs sandboxed; this entitlement declares it explicitly.
	     The identifiers come from the extension's Developer ID provisioning profile
	     (GOGGLESVIEW_EXT_PROFILE). The helper's Mach service name starts with the Team ID, which is what
	     the sandbox's mach-lookup exception for names with the process's own Team ID prefix relies on. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.application-identifier</key>
	<string>5A3R74QNBJ.com.kburiasco.gogglesview.camera</string>
	<key>com.apple.developer.team-identifier</key>
	<string>5A3R74QNBJ</string>
	<!-- Team-ID-prefixed group: the CMIO Mach service name in Info.plist must start with a group the extension holds. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>5A3R74QNBJ.com.kburiasco.gogglesview</string>
	</array>
</dict>
</plist>
